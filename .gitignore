# ====================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ====================================================================
# Ignore third-party package folders
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# ====================================================================
# BUILD & OUTPUT DIRECTORIES
# ====================================================================
# Ignore compiled code, build directories, and binaries
/dist/
/build/
/out/
*.exe
*.dll
*.so

# ====================================================================
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ====================================================================
# Never commit credentials, API keys, or local config configs
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ====================================================================
# LOGS & DIAGNOSTICS
# ====================================================================
# Ignore log files, crash dumps, and history logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ====================================================================
# SYSTEM & IDE FILES
# ====================================================================
# Operating System files
.DS_Store
Thumbs.db

# IDE / Text Editor settings (VS Code, JetBrains, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
